# ORCA Admin (admin.orcarehab.com). Copy to .env.local for local development.

# Shared ORCA API (ORCA_Careers_API): its URL and this app's key (ADMIN_API_KEY there).
ORCA_API_URL=
ORCA_API_KEY=

# Google sign-in: the employee portal's OAuth client. Its authorized redirect URIs must include
# https://admin.orcarehab.com/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAIN=orcarehab.com

# Auth.js: AUTH_SECRET encrypts the session cookie (generate with: openssl rand -base64 32).
# AUTH_URL is required in production: https://admin.orcarehab.com
AUTH_SECRET=
AUTH_URL=

# Where "Employee portal" in the nav points.
NEXT_PUBLIC_PORTAL_URL=https://portal.orcarehab.com
