# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Timezone used to decide "today" for outstanding-note age. Confirm with ORCA.
DASHBOARD_TIMEZONE=America/Los_Angeles
# Seconds to cache dashboard data in memory (keeps Google Sheets API usage low).
CACHE_TTL_SECONDS=300

# ── Data sources (allowlist) ───────────────────────────────────────────────
# ID of "ORCA-NP/Scribe Tracker 2026": the long string in its URL
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
PROVIDER_TRACKER_SPREADSHEET_ID=

# Tab → provider mapping and exclusions. Copy config/provider-tracker.example.json
# to config/provider-tracker.json (gitignored). On Cloud Run, either mount it from
# Secret Manager and set the path, or pass the JSON inline via PROVIDER_TRACKER_CONFIG_JSON.
PROVIDER_TRACKER_CONFIG_PATH=config/provider-tracker.json
# PROVIDER_TRACKER_CONFIG_JSON=

# ORCA Shared Drive ID for the future AI/RAG assistant (optional for now). Find it with
#   npm run check:drive
# Drive access is only a connectivity check until the application RAG allowlist exists.
ORCA_SHARED_DRIVE_ID=

# ── Google credentials ────────────────────────────────────────────────────
# Nothing to set here when using Application Default Credentials (recommended):
#   gcloud auth application-default login \
#     --impersonate-service-account=orca-dashboard-reader@PROJECT_ID.iam.gserviceaccount.com
# Only if you must use a key file, point to it OUTSIDE this repo:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/secrets/orca-dashboard-reader.json

# ── Admin API authentication ──────────────────────────────────────────────
# "disabled" = no auth (local development only; refused when NODE_ENV=production)
# "iap"      = verify Google Cloud IAP identity (production)
AUTH_MODE=disabled
# Required when AUTH_MODE=iap. Shown in the IAP console ("Get JWT audience code"), e.g.
#   /projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
IAP_AUDIENCE=
# Comma-separated Workspace domains and/or explicit emails allowed to use the API.
ADMIN_ALLOWED_DOMAINS=
ADMIN_ALLOWED_EMAILS=
