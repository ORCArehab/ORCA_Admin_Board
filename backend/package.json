{
  "name": "orca-admin-api",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "discover": "tsx --env-file-if-exists=.env scripts/discover-provider-tabs.ts",
    "check:drive": "tsx --env-file-if-exists=.env scripts/check-drive-access.ts"
  },
  "description": "ORCA Rehab Admin Dashboard backend API",
  "dependencies": {
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
